{
  "name": "signatureops",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:clean": "rm -rf apps/web/.next && turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @signatureops/db generate",
    "db:migrate": "pnpm --filter @signatureops/db migrate",
    "db:migrate:deploy": "pnpm --filter @signatureops/db migrate:deploy",
    "db:seed": "pnpm --filter @signatureops/db seed",
    "db:push": "pnpm --filter @signatureops/db push",
    "db:up": "docker compose up -d",
    "db:migrate:assets": "pnpm --filter @signatureops/db migrate:assets"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
