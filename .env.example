# Copy to apps/web/.env.local (Next.js) and/or repo-root .env (Prisma CLI).
# Local Postgres: docker compose up -d && pnpm db:migrate && pnpm db:seed

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/signatureops"
AUTH_SECRET="generate-a-32-byte-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dev-only. Ignored when NODE_ENV=production. Leave unset (or "false") unless
# you need to skip Google login for local UI work.
AUTH_BYPASS="false"

# Cloudflare R2 (S3-compatible). Required in production. Local fallback: disk.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="signatureops-assets"
R2_PUBLIC_BASE_URL="https://assets.example.com"
# Optional. Full S3 API URL if the bucket is jurisdiction-restricted, e.g.
# https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=""
# Optional. If the bucket is EU-restricted, set to "eu" instead of R2_ENDPOINT.
R2_JURISDICTION=""

# Google Workspace deploy (domain-wide delegation). Optional until Google slice.
GOOGLE_SA_CLIENT_EMAIL=""
GOOGLE_SA_PRIVATE_KEY=""
GOOGLE_SA_CLIENT_ID=""

# Microsoft Graph directory sync. Optional until Microsoft slice.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Inngest. Use `npx inngest-cli@latest dev` locally. Required for deploy jobs.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Error tracking. Optional.
SENTRY_DSN=""
