generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RuleLevel {
  USER
  GROUP
  DEPT_OFFICE
  ORG
}

enum AssetKind {
  LOGO
  BANNER
  CERTIFICATION
  PHOTO
  ICON
}

enum AdminRole {
  SUPER_ADMIN
  CONTENT_MANAGER
}

enum DirectorySource {
  MANUAL
  GOOGLE
  MICROSOFT
}

enum Provider {
  GOOGLE
  MICROSOFT
}

enum DeployStatus {
  PENDING
  RUNNING
  OK
  FAILED
  PARTIAL
}

model Organization {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  brandColors            String   @default("[]")
  socialIconMode         String   @default("standard")
  onboardingSkipCampaign Boolean  @default(false)
  googleWorkspaceDomain  String?
  googleImpersonateEmail String?
  microsoftTenantId      String?
  createdAt              DateTime @default(now())

  users       User[]
  groups      Group[]
  templates   Template[]
  rules       Rule[]
  campaigns   Campaign[]
  brandAssets BrandAsset[]
  admins      AdminUser[]
  invites     AdminInvite[]
  deployments Deployment[]
  auditEvents AuditEvent[]
  syncState   SyncState?
}

model AdminUser {
  id        String    @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email     String
  name      String
  googleSub String?
  role      AdminRole @default(CONTENT_MANAGER)
  createdAt DateTime  @default(now())

  @@unique([orgId, email])
  @@index([googleSub])
}

model AdminInvite {
  id         String    @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email      String
  role       AdminRole @default(CONTENT_MANAGER)
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())

  @@index([orgId, email])
}

model User {
  id            String          @id @default(cuid())
  orgId         String
  org           Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  externalId    String
  displayName   String
  jobTitle      String?
  department    String?
  country       String?
  email         String
  mobile        String?
  officePhone   String?
  photoUrl      String?
  sendAsAliases String          @default("[]")
  source        DirectorySource @default(MANUAL)
  managerId     String?
  deployments   Deployment[]

  @@unique([orgId, externalId])
  @@index([orgId, email])
}

model Group {
  id         String @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  externalId String
  name       String
  memberIds  String @default("[]")
  source     DirectorySource @default(MANUAL)

  @@unique([orgId, externalId])
}

model Template {
  id         String   @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  definition String
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Rule {
  id         String    @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  level      RuleLevel
  priority   Int
  conditions String
  actions    String
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Campaign {
  id                  String   @id @default(cuid())
  orgId               String
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name                String
  bannerAssetId       String
  startDate           DateTime
  endDate             DateTime
  slogan              String?
  ctaText             String?
  ctaLink             String?
  logoOverrideAssetId String?
  templateIds         String   @default("[]")
}

model BrandAsset {
  id        String    @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind      AssetKind
  slot      String?
  url       String
  bytes     Int       @default(0)
  width     Int?
  height    Int?
  alt       String?
  createdAt DateTime  @default(now())

  @@index([orgId, slot])
}

model Deployment {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider          Provider
  status            DeployStatus @default(PENDING)
  compiledHtmlHash  String?
  sanitizedDiff     String?
  error             String?
  attempt           Int          @default(0)
  sendAsEmail       String?
  inngestRunId      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([orgId, provider, status])
  @@index([orgId, createdAt])
}

model AuditEvent {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor   String
  action  String
  payload String       @default("{}")
  at      DateTime     @default(now())

  @@index([orgId, at])
}

model SyncState {
  id                   String       @id @default(cuid())
  orgId                String       @unique
  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lastGoogleSyncAt     DateTime?
  lastMicrosoftSyncAt  DateTime?
  googleError          String?
  microsoftError       String?
  googleUserCount      Int          @default(0)
  microsoftUserCount   Int          @default(0)
}
